# Copy to .env and fill in the keys. The process environment overrides this file.

# Runtime
CARCASS_ENV=dev
OTEL_SERVICE_NAME=carcass
# Relative paths are resolved from the repository root.
CARCASS_LOGS_DIR=data/logs
CARCASS_TRACES_DIR=data/traces
LOG_LEVEL=INFO
LOG_RETENTION="30 days"

# OpenRouter chat / vision models
OPENROUTER_URL=https://openrouter.ai/api/v1
CHAT_MAX_RETRIES=2
CHAT_TIMEOUT_S=720
CARCASS_OPENROUTER_API_KEY=
DEFAULT_CHAT_MODEL=anthropic/claude-haiku-5.5
DEFAULT_CAPTION_MODEL=anthropic/claude-haiku-5.5

# Mistral Document AI OCR
MISTRAL_API_KEY=
DEFAULT_OCR_MODEL=mistral-ocr-4-1
DEFAULT_OCR_CHUNK_SIZE=10
DEFAULT_OCR_TIMEOUT_S=600
DEFAULT_OCR_INLINE_MAX_BYTES=47185920
DEFAULT_TABLE_MAX_PIXELS=2000000

# PLU parcel lookup default
DEFAULT_PARCEL_ADDRESS="4 rue Joliot Curie 91190 Gif-sur-Yvette"

# Mock trace generator
MOCK_CHAT_MODEL=deepseek/deepseek-v4.1-flash-1017

# Optional: real-endpoint tests (`pytest -m expensive`)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
